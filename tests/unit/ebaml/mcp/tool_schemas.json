      ],
      "title": "checkout_editArguments",
      "type": "object"
    },
    "describe_feature": {
      "properties": {
        "feature": {
          "title": "Feature",
          "type": "string"
        }
      },
      "required": [
        "feature"
      ],
      "title": "describe_featureArguments",
      "type": "object"
    },
    "describe_model": {
      "properties": {},
      "title": "describe_modelArguments",
      "type": "object"
    },
    "explain_prediction": {
      "$defs": {
        "AllowedValuesArgument": {
          "description": "The allowed values of one feature, as a tool takes them.\n\nGive ``levels`` for a nominal or ordinal feature. Give ``low``, ``high`` or both, and ``match``, for a continuous\nfeature. A missing end has no limit.",
          "properties": {
            "high": {
              "title": "High",
              "type": "number"
            },
            "levels": {
              "items": {
                "type": "string"
              },
              "title": "Levels",
              "type": "array"
            },
            "low": {
              "title": "Low",
              "type": "number"
            },
            "match": {
              "$ref": "#/$defs/RangeMatch"
            }
          },
          "title": "AllowedValuesArgument",
          "type": "object"
        },
        "CostStrategyName": {
          "description": "The base cost strategy that a tool takes by name, under the difficulties of an agent.",
          "enum": [
            "unit",
            "data"
          ],
          "title": "CostStrategyName",
          "type": "string"
        },
        "FeatureValue": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "RangeMatch": {
          "description": "Which bins of a continuous feature a ``ValueRange`` allows.\n\nAn EBM groups the values of a continuous feature in bins, so a range of values and a bin can overlap in part.\n\nAttributes\n----------\nOVERLAP\n    A bin is allowed when some of its values are in the range. Use it when the person can reach any value in the\n    range, so a bin with one reachable value is a real option.\nINSIDE\n    A bin is allowed only when all of its values are in the range. Use it when every value of the chosen bin must\n    be reachable, for example when the plan must hold for the whole bin.",
          "enum": [
            "overlap",
            "inside"
          ],
          "title": "RangeMatch",
          "type": "string"
        }
      },
      "properties": {
        "allowed": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/AllowedValuesArgument"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Allowed"
        },
        "confidence_level": {
          "default": 0.95,
          "title": "Confidence Level",
          "type": "number"
        },
        "cost_strategy": {
          "$ref": "#/$defs/CostStrategyName",
          "default": "unit"
        },
        "difficulty": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "number"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Difficulty"
        },
        "difficulty_from_model": {
          "default": false,
          "title": "Difficulty From Model",
          "type": "boolean"
        },
        "immutable": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Immutable",
          "type": "array"
        },
        "instance": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/FeatureValue"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Instance"
        },
        "max_changes": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Changes"
        },
        "plans": {
          "default": 1,
          "title": "Plans",
          "type": "integer"
        },
        "revision": {
          "default": "current",
          "title": "Revision",
          "type": "string"
        },
        "row": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Row"
        }
      },
      "title": "explain_predictionArguments",
      "type": "object"
    },
    "get_affected_profile": {
