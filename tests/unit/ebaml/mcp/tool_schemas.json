{
  "resource_templates": [
    "ebm://graphs/{feature}"
  ],
  "tools": {
    "apply_edit": {
      "$defs": {
        "JSONValue": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "boolean"
            },
            {
              "type": "number"
            },
            {
              "items": {
                "$ref": "#/$defs/JSONValue"
              },
              "type": "array"
            },
            {
              "additionalProperties": {
                "$ref": "#/$defs/JSONValue"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "properties": {
        "edit": {
          "additionalProperties": {
            "$ref": "#/$defs/JSONValue"
          },
          "title": "Edit",
          "type": "object"
        },
        "expected_revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Revision"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "edit",
        "reason"
      ],
      "title": "apply_editArguments",
      "type": "object"
    },
    "check_constraints": {
      "$defs": {
        "JSONValue": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "boolean"
            },
            {
              "type": "number"
            },
            {
              "items": {
                "$ref": "#/$defs/JSONValue"
              },
              "type": "array"
            },
            {
              "additionalProperties": {
                "$ref": "#/$defs/JSONValue"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "properties": {
        "constraints": {
          "items": {
            "additionalProperties": {
              "$ref": "#/$defs/JSONValue"
            },
            "type": "object"
          },
          "title": "Constraints",
          "type": "array"
        },
        "revision": {
          "default": "current",
          "title": "Revision",
          "type": "string"
        },
        "tolerance": {
          "default": 1e-9,
          "title": "Tolerance",
          "type": "number"
        }
      },
      "required": [
        "constraints"
      ],
      "title": "check_constraintsArguments",
      "type": "object"
    },
    "checkout_edit": {
      "properties": {
        "expected_revision": {
          "anyOf": [
            {
              "type": "string"
            },
