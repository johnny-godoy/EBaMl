{
  "resource_templates": [
    "ebm://graphs/{feature}"
  ],
  "tools": {
    "apply_edit": {
      "$defs": {
        "JSONValue": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "boolean"
            },
            {
              "type": "number"
            },
            {
              "items": {
                "$ref": "#/$defs/JSONValue"
              },
              "type": "array"
            },
            {
              "additionalProperties": {
                "$ref": "#/$defs/JSONValue"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "properties": {
        "edit": {
          "additionalProperties": {
            "$ref": "#/$defs/JSONValue"
          },
          "title": "Edit",
          "type": "object"
        },
        "expected_revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Revision"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "edit",
        "reason"
      ],
      "title": "apply_editArguments",
      "type": "object"
    },
    "checkout_edit": {
      "properties": {
        "expected_revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Revision"
        },
        "revision": {
          "title": "Revision",
          "type": "string"
        }
      },
      "required": [
        "revision"
      ],
      "title": "checkout_editArguments",
      "type": "object"
    },
    "describe_feature": {
      "properties": {
        "feature": {
          "title": "Feature",
          "type": "string"
        }
      },
      "required": [
        "feature"
      ],
      "title": "describe_featureArguments",
      "type": "object"
    },
    "describe_model": {
      "properties": {},
      "title": "describe_modelArguments",
      "type": "object"
    },
    "explain_prediction": {
      "$defs": {
        "FeatureValue": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "properties": {
        "confidence_level": {
          "default": 0.95,
          "title": "Confidence Level",
          "type": "number"
        },
        "instance": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/FeatureValue"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Instance"
        },
        "revision": {
          "default": "current",
          "title": "Revision",
          "type": "string"
        },
        "row": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Row"
        }
      },
      "title": "explain_predictionArguments",
      "type": "object"
    },
    "get_graph": {
      "properties": {
        "feature": {
          "title": "Feature",
          "type": "string"
        },
        "max_tokens": {
          "default": 3000,
          "title": "Max Tokens",
          "type": "integer"
        },
        "normalization": {
          "default": "none",
          "enum": [
            "none",
            "min_max",
            "z_score"
          ],
          "title": "Normalization",
          "type": "string"
        },
        "revision": {
          "default": "current",
          "title": "Revision",
          "type": "string"
        },
        "x_axis_precision": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "X Axis Precision"
        },
        "y_axis_precision": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Y Axis Precision"
        }
      },
      "required": [
        "feature"
      ],
      "title": "get_graphArguments",
      "type": "object"
    },
    "get_model_summary": {
      "properties": {
        "revision": {
          "default": "current",
          "title": "Revision",
          "type": "string"
        }
      },
      "title": "get_model_summaryArguments",
      "type": "object"
    },
    "list_bins": {
      "properties": {
        "feature": {
          "title": "Feature",
          "type": "string"
        },
        "revision": {
          "default": "current",
          "title": "Revision",
          "type": "string"
        }
      },
      "required": [
        "feature"
      ],
      "title": "list_binsArguments",
      "type": "object"
    },
    "list_edits": {
      "properties": {
        "include_replay_json": {
          "default": false,
          "title": "Include Replay Json",
          "type": "boolean"
        }
      },
      "title": "list_editsArguments",
      "type": "object"
    },
    "list_features": {
      "properties": {
        "revision": {
          "default": "current",
          "title": "Revision",
          "type": "string"
        }
      },
      "title": "list_featuresArguments",
      "type": "object"
    },
    "preview_edit": {
      "$defs": {
        "JSONValue": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "boolean"
            },
            {
              "type": "number"
            },
            {
              "items": {
                "$ref": "#/$defs/JSONValue"
              },
              "type": "array"
            },
            {
              "additionalProperties": {
                "$ref": "#/$defs/JSONValue"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "properties": {
        "edit": {
          "additionalProperties": {
            "$ref": "#/$defs/JSONValue"
          },
          "title": "Edit",
          "type": "object"
        },
        "revision": {
          "default": "current",
          "title": "Revision",
          "type": "string"
        }
      },
      "required": [
        "edit"
      ],
      "title": "preview_editArguments",
      "type": "object"
    },
    "redo_edit": {
      "properties": {
        "expected_revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Revision"
        }
      },
      "title": "redo_editArguments",
      "type": "object"
    },
    "save_model": {
      "properties": {
        "expected_revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Revision"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "message"
      ],
      "title": "save_modelArguments",
      "type": "object"
    },
    "undo_edit": {
      "properties": {
        "expected_revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Revision"
        }
      },
      "title": "undo_editArguments",
      "type": "object"
    }
  }
}
