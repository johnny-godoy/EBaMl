          "type": "data",
          "data": {
            "text/markdown": "<span class=\"markdown prose dark:prose-invert contents\"><h2 id=\"shift-the-scores\">Shift the scores</h2>\n<span class=\"paragraph\"><code>Normalization.MIN_MAX</code> and <code>Normalization.Z_SCORE</code> shift all the scores of the graph by one number. The\ndifferences between the classes of a bin, which carry the meaning, do not change. Here the smallest score becomes\nzero.</span></span>"
          }
        }
      ],
      "console": []
    },
