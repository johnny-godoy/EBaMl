    {
      "id": "BYtC",
      "code_hash": "5e46c4ae49b73e2b6146da053be1a692",
      "outputs": [
        {
          "type": "data",
          "data": {
            "text/markdown": "<span class=\"markdown prose dark:prose-invert contents\"><h2 id=\"select-the-classes\">Select the classes</h2>\n<span class=\"paragraph\">The text of a model with many classes is long. <code>classes</code> keeps some classes, in the order that you give. The\nscores stay centred over all the classes of the model, so a bin of the selected classes need not have a mean of\nzero. <code>describe_graph</code> and <code>describe_ebm</code> take the same option as <code>GraphOptions(classes=[...])</code>.</span></span>"
          }
        }
      ],
      "console": []
    },
